{
  "name": "essafaria-visa-os",
  "version": "1.0.0",
  "private": true,
  "description": "ESSAFARIA VISA OS — B2B visa operations platform for ESSAFARIA TRAVEL",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/build.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "db:up": "tsx scripts/dev-db.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "dr:manifest": "tsx scripts/dr-verify-manifest.ts",
    "dr:restore-verify": "tsx scripts/dr-verify-restore.ts",
    "dr:backup": "tsx scripts/dr-create-backup.ts",
    "dr:restore": "tsx scripts/dr-restore.ts",
    "dr:finalize": "tsx scripts/dr-finalize.ts",
    "dr:local-drill": "tsx scripts/dr-local-drill.ts",
    "dr:offsite-verify": "tsx scripts/dr-verify-offsite-copy.ts",
    "dr:repo-safety": "tsx scripts/dr-repo-safety.ts",
    "dr:app-verify": "tsx scripts/dr-verify-restored-app.ts",
    "dr:key": "tsx scripts/dr-generate-key.ts",
    "dr:prod-preflight": "tsx scripts/dr-prod-preflight.ts",
    "dr:status": "tsx scripts/dr-status.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^5.0.1",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
