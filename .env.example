# ESSAFARIA — copy to .env.local. Never commit real credentials.
# The app uses server-side node-postgres + Drizzle, NOT Supabase Auth/JS.

# REQUIRED on Vercel. Use exactly one Preview DATABASE_URL.
# Supabase: copy the transaction-pooler PostgreSQL URI from Connect (port 6543).
# Preserve provider TLS options; never disable certificate verification.
# Local development only:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/essafaria"

# OPTIONAL, CLI migration only. Direct PostgreSQL URI, or session pooler (5432)
# when IPv6 is unavailable. Omit to use DATABASE_URL (runner is pooler-safe).
# MIGRATION_DATABASE_URL="<server-only PostgreSQL URI>"

# Optional storage: db is the default and needs no additional credentials.
STORAGE_PROVIDER="db"
# Only needed when STORAGE_PROVIDER=supabase; all three remain SERVER ONLY.
# SUPABASE_URL="https://xgetzgixalrsmuvfthpf.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<server-only secret>"
# SUPABASE_STORAGE_BUCKET="visa-documents"

# No SESSION_SECRET or JWT_SECRET: opaque random sessions are hashed in the DB.
# No NEXT_PUBLIC_* secret variables. Do not set NODE_ENV; Vercel manages it.

# Demo seeding is NEVER part of production. It is blocked for Production
# deployments (VERCEL_ENV=production). A Vercel PREVIEW build runs the guarded
# demo seed only when ALLOW_DEMO_SEED=true (Preview scope); remote databases
# additionally require non-default SEED passwords.
# ALLOW_DEMO_SEED="true"
# SEED_ADMIN_PASSWORD="<unique non-default password>"
# SEED_AGENCY_PASSWORD="<unique non-default password>"
# Keep this application separate from legacy tables in a shared database.
# Use visa_os_preview for Preview and visa_os for Production on this project.
DATABASE_SCHEMA=public

# Optional observability controls. Keep SERVER ONLY.
# Protects /api/internal/health/deep. If unset, the deep endpoint is disabled.
# HEALTHCHECK_TOKEN="<random high-entropy operator token, minimum 32 bytes>"
# Enables stable pseudonymous correlation without logging raw user/agency identifiers.
# TELEMETRY_PSEUDONYMIZATION_KEY="<random high-entropy HMAC key, minimum 32 bytes>"
# REQUIRED when VERCEL_ENV=production: exact UTC activation timestamp for the
# Observability Gate. This prevents pre-deployment legacy writes from being
# misclassified as new post-cutover integrity violations.
# OBSERVABILITY_CUTOVER_AT="2026-10-03T20:00:00.000Z"
