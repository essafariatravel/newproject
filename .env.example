# ===============================================
# ESSAFARIA VISA OS — Environment Variables
# ===============================================
# Copy to .env.local for development.
# NEVER commit real secrets.

# ---- Database (required) -----------------------
# PostgreSQL connection string used by the app, migrations and seed.
# Development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/essafaria"
# Production (Supabase / managed Postgres) — use the pooled connection string:
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# ---- Session / crypto (required) ---------------
# 32+ byte random string. Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-long-random-secret"

# ---- Document storage (optional) ---------------
# STORAGE_PROVIDER=db  (default)  Documents are stored in PostgreSQL bytea.
# STORAGE_PROVIDER=supabase        Documents are stored in a Supabase Storage bucket.
STORAGE_PROVIDER="db"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="visa-documents"

# ---- Environment marker ------------------------
# development | preview | production
NODE_ENV="development"

# ---- Seed admin password (dev/demo only) -------
SEED_ADMIN_PASSWORD="Admin!2345"
SEED_AGENCY_PASSWORD="Agency!2345"
